{
  "_meta": {"name": "SolarWise Design System", "version": "1.0.0", "principle": "Engineering calm: dark ink, solar amber for action, semantic colours only for verdicts. Never colour alone — status always has an icon and a label."},
  "primitive": {
    "color": {
      "ink-950": "#07131F", "ink-900": "#0B1F33", "ink-800": "#12304D", "ink-700": "#1E4568",
      "slate-600": "#475569", "slate-400": "#94A3B8", "slate-200": "#CBD5E1", "slate-100": "#E8EEF5", "slate-50": "#F5F8FB",
      "amber-600": "#D97706", "amber-500": "#F59E0B", "amber-300": "#FCD34D", "amber-100": "#FEF3C7",
      "teal-700": "#0F766E", "teal-100": "#CCFBF1",
      "red-700": "#B91C1C", "red-100": "#FEE2E2",
      "orange-700": "#B45309", "orange-100": "#FFEDD5",
      "white": "#FFFFFF"
    },
    "font": {"sans": "'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif", "display": "'Space Grotesk', 'Inter', system-ui, sans-serif", "mono": "'JetBrains Mono', 'SFMono-Regular', Consolas, monospace"},
    "space": {"1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px"},
    "radius": {"sm": "6px", "md": "10px", "lg": "16px", "pill": "999px"},
    "shadow": {"sm": "0 1px 2px rgba(11,31,51,.08)", "md": "0 4px 14px rgba(11,31,51,.10)"},
    "size": {"xs": "12px", "sm": "13.5px", "md": "15px", "lg": "18px", "xl": "24px", "2xl": "32px"}
  },
  "semantic": {
    "surface-page": "{primitive.color.slate-50}", "surface-card": "{primitive.color.white}", "surface-inverse": "{primitive.color.ink-900}",
    "text-primary": "{primitive.color.ink-900}", "text-secondary": "{primitive.color.slate-600}", "text-inverse": "{primitive.color.white}",
    "border-default": "{primitive.color.slate-200}",
    "action-primary": "{primitive.color.amber-500}", "action-primary-hover": "{primitive.color.amber-600}", "action-primary-text": "{primitive.color.ink-900}",
    "focus-ring": "{primitive.color.ink-700}",
    "status-ok-fg": "{primitive.color.teal-700}", "status-ok-bg": "{primitive.color.teal-100}",
    "status-warn-fg": "{primitive.color.orange-700}", "status-warn-bg": "{primitive.color.orange-100}",
    "status-fail-fg": "{primitive.color.red-700}", "status-fail-bg": "{primitive.color.red-100}",
    "status-incomplete-fg": "{primitive.color.slate-600}", "status-incomplete-bg": "{primitive.color.slate-100}",
    "preliminary-bg": "{primitive.color.amber-100}", "preliminary-fg": "{primitive.color.ink-900}"
  },
  "component": {
    "button-bg": "{semantic.action-primary}", "button-bg-hover": "{semantic.action-primary-hover}", "button-fg": "{semantic.action-primary-text}", "button-radius": "{primitive.radius.md}",
    "card-bg": "{semantic.surface-card}", "card-border": "{semantic.border-default}", "card-radius": "{primitive.radius.lg}", "card-shadow": "{primitive.shadow.sm}", "card-padding": "{primitive.space.5}",
    "metric-value-font": "{primitive.font.display}", "metric-value-size": "{primitive.size.xl}",
    "badge-radius": "{primitive.radius.pill}",
    "banner-bg": "{semantic.preliminary-bg}", "banner-fg": "{semantic.preliminary-fg}",
    "citation-bg": "{primitive.color.slate-100}", "citation-font": "{primitive.font.mono}"
  }
}
